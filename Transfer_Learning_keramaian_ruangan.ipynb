   "source": [
    "import os, re, json, time, shutil, random, zipfile, copy\n",
    "from pathlib import Path\n",
    "from collections import Counter\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from PIL import Image\n",
    "\n",
    "import torch, torch.nn as nn\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from torchvision import models, transforms\n",
    "from sklearn.metrics import accuracy_score, f1_score, confusion_matrix, classification_report\n",
    "\n",
    "# KONFIGURASI \n",
    "ZIP_PATH        = None                     # None = cari otomatis file SANINDO*.zip di folder notebook\n",
    "RAW_DIR         = Path(\"dataset_raw\")      # folder hasil: dataset_raw/<kelas>/*.jpg\n",
    "OUT_DIR         = Path(\"outputs\")          # tabel, grafik, checkpoint, README\n",
    "N_PER_CLASS     = 150                      # citra per kelas\n",
    "SPLIT_BY_VIDEO  = False                    # True = split berdasarkan video (anti-leakage)\n",
    "IMG_SIZE        = 224\n",
    "BATCH_SIZE      = 32\n",
    "EPOCHS          = 10\n",
    "SEED            = 42\n",
    "MODES           = [\"scratch\", \"feature_extraction\", \"fine_tuning\"]\n",
    "LR              = {\"scratch\": 1e-3, \"feature_extraction\": 1e-3, \"fine_tuning\": 1e-4}  \n",
    "FT_FROM_BLOCK   = 14                      \n",
    "\n",
    "def CLASS_RULE(n_person: int) -> str:\n",
    "    if n_person <= 2: return \"sepi\"\n",
    "    if n_person == 3: return \"sedang\"\n",
    "    return \"ramai\"\n",
    "CLASSES = [\"sepi\", \"sedang\", \"ramai\"]\n",
    "\n",
    "\n",
    "def set_seed(s):\n",
    "    random.seed(s); np.random.seed(s); torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n",
    "set_seed(SEED)\n",
    "OUT_DIR.mkdir(exist_ok=True)\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "print(\"Device:\", device, \"| torch\", torch.__version__)"
   ]
  },
