    "#  Baca anotasi COCO -> hitung jumlah 'person' per citra -> tentukan kelas\n",
    "rows = []\n",
    "for split in [\"train\", \"valid\", \"test\"]:\n",
    "    coco = json.load(open(SRC_DIR / split / \"_annotations.coco.json\"))\n",
    "    person_ids = {c[\"id\"] for c in coco[\"categories\"] if c[\"name\"] == \"person\"}\n",
    "    cnt = Counter(a[\"image_id\"] for a in coco[\"annotations\"] if a[\"category_id\"] in person_ids)\n",
    "    for im in coco[\"images\"]:\n",
    "        orig = im[\"extra\"][\"name\"] if \"extra\" in im and \"name\" in im[\"extra\"] else im[\"file_name\"]\n",
    "        m = re.match(r\"img_v(\\d+)_\", orig)\n",
    "        n = cnt.get(im[\"id\"], 0)\n",
    "        rows.append(dict(src_path=str(SRC_DIR / split / im[\"file_name\"]), filename=im[\"file_name\"],\n",
    "                         original_name=orig, video_id=int(m.group(1)) if m else -1,\n",
    "                         n_person=n, label=CLASS_RULE(n), split=split))\n",
    "meta = pd.DataFrame(rows)\n",
    "\n",
    "# 2) (opsional) split ulang berdasarkan video agar tidak ada kebocoran antar split \n",
    "if SPLIT_BY_VIDEO:\n",
    "    rng = np.random.RandomState(SEED)\n",
    "    vids = rng.permutation(sorted(meta.video_id.unique()))\n",
    "    n_te, n_va = max(1, round(len(vids)*0.10)), max(1, round(len(vids)*0.20))\n",
    "    te, va = set(vids[:n_te]), set(vids[n_te:n_te+n_va])\n",
    "    meta[\"split\"] = meta.video_id.map(lambda v: \"test\" if v in te else \"valid\" if v in va else \"train\")\n",
    "\n",
    "# kurangi jumlah citra per kelas supaya training lebih cepat \n",
    "#     Diambil acak, proporsi train/valid/test = 70/15/15 per kelas, mengikuti split di atas.\n",
    "if N_PER_CLASS is not None:\n",
    "    frac = {\"train\": 0.70, \"valid\": 0.15, \"test\": 0.15}\n",
    "    parts = []\n",
    "    for c in CLASSES:\n",
    "        for sp, f in frac.items():\n",
    "            sub = meta[(meta.label == c) & (meta.split == sp)]\n",
    "            parts.append(sub.sample(min(len(sub), round(N_PER_CLASS * f)), random_state=SEED))\n",
    "    meta = pd.concat(parts).reset_index(drop=True)\n",
    "\n",
    "# dataset_raw/<kelas>/\n",
    "if RAW_DIR.exists(): shutil.rmtree(RAW_DIR)\n",
    "for c in CLASSES: (RAW_DIR / c).mkdir(parents=True, exist_ok=True)\n",
    "paths = []\n",
    "for r in meta.itertuples():\n",
    "    dst = RAW_DIR / r.label / r.filename\n",
    "    shutil.copy2(r.src_path, dst); paths.append(str(dst))\n",
    "meta[\"filepath\"] = paths\n",
    "meta = meta[[\"filepath\",\"filename\",\"original_name\",\"video_id\",\"n_person\",\"label\",\"split\"]]\n",
    "meta.to_csv(\"metadata.csv\", index=False)\n",
    "\n",
    "# Validasi syarat tugas: >= 50 citra per kelas ---\n",
    "tab = pd.crosstab(meta.label, meta.split).reindex(CLASSES)\n",
    "tab[\"total\"] = tab.sum(axis=1)\n",
    "display(tab)\n",
    "assert (tab[\"total\"] >= 50).all(), \"Ada kelas dengan < 50 citra! Ubah CLASS_RULE.\"\n",
    "print(\"OK: semua kelas >= 50 citra. metadata.csv & dataset_raw/ siap.\")\n",
    "meta.head()"
   ]
  },
