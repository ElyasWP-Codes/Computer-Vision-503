    "    except ImportError:\n",
    "        raise FileNotFoundError(\n",
    "            \"Zip dataset tidak ditemukan. Taruh file SANINDO...zip di folder yang sama dengan notebook, \"\n",
    "            f\"atau isi ZIP_PATH manual. Folder kerja saat ini: {os.getcwd()}\")\n",
    "print(\"Memakai zip:\", ZIP_PATH)\n",
    "\n",
    "# 3) ekstrak \n",
    "SRC_DIR = Path(\"sanindo_src\")\n",
    "if not SRC_DIR.exists():\n",
    "    with zipfile.ZipFile(ZIP_PATH) as z:\n",
    "        z.extractall(SRC_DIR)\n",
    "print(\"Isi folder dataset:\", sorted(p.name for p in SRC_DIR.iterdir()))"
   ]
