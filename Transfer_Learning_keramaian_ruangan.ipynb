   "source": [
    "def run_epoch(model, dl, mode, opt=None):\n",
    "    train = opt is not None\n",
    "    model.train(train)\n",
    "    if train and mode == \"feature_extraction\": model.features.eval()   \n",
    "    tot_loss = correct = n = 0\n",
    "    with torch.set_grad_enabled(train):\n",
    "        for x, y in dl:\n",
    "            x, y = x.to(device), y.to(device)\n",
    "            out = model(x); loss = nn.functional.cross_entropy(out, y)\n",
    "            if train: opt.zero_grad(); loss.backward(); opt.step()\n",
    "            tot_loss += loss.item() * len(y); correct += (out.argmax(1) == y).sum().item(); n += len(y)\n",
    "    return tot_loss / n, correct / n\n",
    "\n",
    "def train_mode(mode):\n",
    "    set_seed(SEED)\n",
    "    model = build_model(mode).to(device)\n",
    "    if mode == \"fine_tuning\":\n",
    "        bb = [p for n_, p in model.named_parameters() if p.requires_grad and not n_.startswith(\"classifier\")]\n",
    "        hd = list(model.classifier.parameters())\n",
    "        opt = torch.optim.Adam([{\"params\": bb, \"lr\": LR[mode]}, {\"params\": hd, \"lr\": 1e-3}])\n",
    "    else:\n",
    "        opt = torch.optim.Adam([p for p in model.parameters() if p.requires_grad], lr=LR[mode])\n",
    "    hist, best, best_state, t0 = [], -1, None, time.time()\n",
    "    for ep in range(1, EPOCHS + 1):\n",
    "        tl, ta = run_epoch(model, train_dl, mode, opt)\n",
    "        vl, va = run_epoch(model, val_dl, mode)\n",
    "        hist.append(dict(mode=mode, epoch=ep, train_loss=tl, train_acc=ta, val_loss=vl, val_acc=va))\n",
    "        if va > best: best, best_ep, best_state = va, ep, copy.deepcopy(model.state_dict())\n",
    "        print(f\"[{mode}] ep {ep:2d}/{EPOCHS}  train {ta:.3f} (loss {tl:.3f}) | val {va:.3f} (loss {vl:.3f})\")\n",
    "    train_time = time.time() - t0\n",
    "    torch.save(best_state, OUT_DIR / f\"{mode}_best.pt\")\n",
    "    model.load_state_dict(best_state)\n",
    "    return model, pd.DataFrame(hist), best, best_ep, train_time\n",
    "\n",
    "results, histories, trained = [], [], {}\n",
    "for mode in MODES:\n",
    "    model, h, best_va, best_ep, tt = train_mode(mode)\n",
    "    # evaluasi test \n",
    "    model.eval(); ys, ps = [], []\n",
    "    with torch.no_grad():\n",
    "        for x, y in test_dl:\n",
    "            ps += model(x.to(device)).argmax(1).cpu().tolist(); ys += y.tolist()\n",
    "    trained[mode] = model; histories.append(h)\n",
    "    results.append({\"Mode\": mode, \"Param terlatih\": n_params(model, True), \"Best val acc\": best_va, \"Epoch terbaik\": best_ep,\n",
    "                    \"Test acc\": accuracy_score(ys, ps), \"Test macro-F1\": f1_score(ys, ps, average=\"macro\"),\n",
    "                    \"Waktu training (s)\": tt, \"_y\": ys, \"_p\": ps})\n",
    "hist_df = pd.concat(histories, ignore_index=True)\n",
    "hist_df.to_csv(OUT_DIR / \"history_per_epoch.csv\", index=False)"
   ]
  },
