   "source": [
    "## 3. DataLoader (dibaca dari `metadata.csv`)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "efffa60e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{'train': 315, 'valid': 66, 'test': 66}\n"
     ]
    }
   ],
   "source": [
    "meta = pd.read_csv(\"metadata.csv\")\n",
    "cls2idx = {c: i for i, c in enumerate(CLASSES)}\n",
    "mean, std = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]\n",
    "\n",
    "tf_train = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.RandomHorizontalFlip(),\n",
    "    transforms.ColorJitter(0.2, 0.2, 0.2),\n",
    "    transforms.ToTensor(), transforms.Normalize(mean, std)])\n",
    "tf_eval = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.ToTensor(), transforms.Normalize(mean, std)])\n",
    "\n",
    "class CsvDataset(Dataset):\n",
    "    def __init__(self, df, tf): self.df, self.tf = df.reset_index(drop=True), tf\n",
    "    def __len__(self): return len(self.df)\n",
    "    def __getitem__(self, i):\n",
    "        r = self.df.iloc[i]\n",
    "        return self.tf(Image.open(r.filepath).convert(\"RGB\")), cls2idx[r.label]\n",
    "\n",
    "nw = 0\n",
    "def make_loader(split, tf, shuffle):\n",
    "    return DataLoader(CsvDataset(meta[meta.split == split], tf), batch_size=BATCH_SIZE,\n",
    "                      shuffle=shuffle, num_workers=nw, pin_memory=device.type == \"cuda\")\n",
    "train_dl, val_dl, test_dl = make_loader(\"train\", tf_train, True), make_loader(\"valid\", tf_eval, False), make_loader(\"test\", tf_eval, False)\n",
    "print({k: len(d.dataset) for k, d in zip([\"train\",\"valid\",\"test\"], [train_dl, val_dl, test_dl])})"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5cb88f06",
   "metadata": {},
   "source": [
    "## 4. Model & 3 Mode Transfer Learning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "abe3174e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "scratch              trainable  2,227,715 / total 2,227,715\n",
      "feature_extraction   trainable      3,843 / total 2,227,715\n",
      "fine_tuning          trainable  1,685,187 / total 2,227,715\n"
     ]
    }
   ],
   "source": [
    "def build_model(mode):\n",
    "    weights = None if mode == \"scratch\" else models.MobileNet_V2_Weights.IMAGENET1K_V1\n",
    "    m = models.mobilenet_v2(weights=weights)\n",
    "    m.classifier[1] = nn.Linear(m.last_channel, len(CLASSES))       \n",
    "    if mode == \"feature_extraction\":\n",
    "        for p in m.features.parameters(): p.requires_grad = False   \n",
    "    elif mode == \"fine_tuning\":\n",
    "        for i, blk in enumerate(m.features):\n",
    "            for p in blk.parameters(): p.requires_grad = i >= FT_FROM_BLOCK\n",
    "    return m\n",
    "\n",
    "def n_params(m, trainable=False):\n",
    "    return sum(p.numel() for p in m.parameters() if (p.requires_grad or not trainable))\n",
    "\n",
    "for md_ in MODES:\n",
    "    m = build_model(md_)\n",
